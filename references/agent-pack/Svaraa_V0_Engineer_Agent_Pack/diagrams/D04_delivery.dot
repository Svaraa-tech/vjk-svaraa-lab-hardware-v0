digraph G{graph[bgcolor="white",pad=.3,nodesep=.3,ranksep=.5];node[shape=box,style="rounded,filled",fillcolor="#edf4f6",color="#35596b",fontname="Helvetica",fontsize=14,margin=".18,.12"];edge[color="#477c85",fontname="Helvetica",fontsize=11];rankdir=TB;a[label="Qualified physical SOS
Never wait for GPS or AI"];b[label="Immutable event ID + incident ID
Bounded journal; volatile fallback if failed"];c[label="Qualified route available?",shape=diamond];d[label="Send original bytes / event ID"];e[label="Local warning: NOT DELIVERED
